@model IEnumerable<PapeleriaMVC.Models.Producto>

@{
    ViewData["Title"] = "Productos";
    var categorias = (Dictionary<int, string>)ViewBag.Categorias;
    var proveedores = (Dictionary<int, string>)ViewBag.Proveedores;
}

<h1>Productos</h1>

<p><a class="btn btn-success" asp-action="Create">Nuevo producto</a></p>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Stock</th>
            <th>Categoría</th>
            <th>Proveedor</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.Precio.ToString("C")</td>
                <td>@item.Stock</td>
                <td>@(categorias.TryGetValue(item.CategoriaId, out var c) ? c : "")</td>
                <td>@(item.ProveedorId.HasValue && proveedores.TryGetValue(item.ProveedorId.Value, out var p) ? p : "—")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
